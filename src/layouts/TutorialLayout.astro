---
const { frontmatter } = Astro.props;
const brand = "HireReady";

const all = Object.values(
  import.meta.glob(['../pages/python/*.md', '../pages/career/*.md'], { eager: true })
);

const current = Astro.url.pathname.replace(/\/$/, "");
const section = current.split("/")[1] || "python";

const sectionList = [
  { key: "python", title: "Python Course", home: "/python/" },
  { key: "career", title: "Career Guides", home: "/career/" },
];

const data = sectionList.map((s) => {
  const lessons = all
    .filter((p) => p.url.startsWith(`/${s.key}/`))
    .map((p) => ({
      url: p.url,
      title: p.frontmatter.title,
      order: p.frontmatter.order ?? 999,
      group: p.frontmatter.group ?? s.title,
    }))
    .sort((a, b) => a.order - b.order);
  const groups = [...new Set(lessons.map((l) => l.group))];
  return { ...s, lessons, groups };
});

const currentLessons = data.find((s) => s.key === section)?.lessons ?? [];
const i = currentLessons.findIndex((l) => l.url === current);
const prev = i > 0 ? currentLessons[i - 1] : null;
const next = i >= 0 && i < currentLessons.length - 1 ? currentLessons[i + 1] : null;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title} | {brand}</title>
    <meta name="description" content={frontmatter.description} />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; display: flex; min-height: 100vh; color: #1f2937; }
      nav { width: 260px; background: #f3f4f6; padding: 20px; box-sizing: border-box; }
      nav h3 { margin-top: 0; }
      nav a { display: block; padding: 4px 0; color: #1f2937; text-decoration: none; font-size: 14px; }
      nav a:hover { color: #2563eb; }
      nav a.active { color: #2563eb; font-weight: bold; }
      nav details { margin-bottom: 12px; border-bottom: 1px solid #d1d5db; padding-bottom: 8px; }
      nav summary { cursor: pointer; font-weight: bold; font-size: 15px; padding: 4px 0; }
      nav .group { display: block; margin-top: 10px; font-weight: bold; font-size: 13px; color: #6b7280; }
      nav .all { color: #2563eb; }
      .extras { margin-top: 12px; padding: 10px 12px; background: #e5e7eb; border-radius: 8px; }
      .extras a { font-weight: bold; }
      main { flex: 1; padding: 30px; max-width: 800px; line-height: 1.7; }
      pre { background: #111827; color: #f9fafb; padding: 14px; border-radius: 6px; overflow-x: auto; }
      code { font-size: 0.95em; }
      table { border-collapse: collapse; margin: 12px 0; }
      th, td { border: 1px solid #d1d5db; padding: 6px 12px; text-align: left; }
      .pn { display: flex; justify-content: space-between; gap: 12px; margin-top: 40px; padding-top: 16px; border-top: 1px solid #e5e7eb; }
      .pn a { color: #2563eb; text-decoration: none; }
      @media (max-width: 700px) { body { flex-direction: column; } nav { width: 100%; } }
    </style>
  </head>
  <body>
    <nav>
      <h3><a href="/">{brand}</a></h3>

      {data.map((s) => (
        <details open={s.key === section}>
          <summary>{s.title}</summary>
          <a class="all" href={s.home}>See all &rarr;</a>
          {s.groups.map((g) => (
            <div>
              <span class="group">{g}</span>
              {s.lessons.filter((l) => l.group === g).map((l) => (
                <a href={l.url} class={l.url === current ? "active" : ""}>{l.title}</a>
              ))}
            </div>
          ))}
        </details>
      ))}

      <div class="extras">
        <a href="/tools/free-resume-builder.html">Free Resume Builder</a>
        <a href="/tools/ats-keyword-matcher.html">Free ATS Keyword Tool</a>
        <a href="/tools/practice-quiz.html">Practice Quiz</a>
        <a href="/#resume-analysis">ATS Resume Analysis</a>
      </div>
    </nav>
    <main>
      <h1>{frontmatter.title}</h1>
      <slot />
      <div class="pn">
        <span>{prev && <a href={prev.url}>&larr; {prev.title}</a>}</span>
        <span>{next && <a href={next.url}>{next.title} &rarr;</a>}</span>
      </div>
    </main>
  </body>
</html>