---
const brand = "HireReady";
const price = "Rs 149";
const upi = "6265543585-2@ybl";
const whatsapp = "919663519674";
const payLink = ""; // Paste your Razorpay Payment Link here later, e.g. https://rzp.io/l/abc
const waLink = `https://wa.me/${whatsapp}?text=${encodeURIComponent("Hi, I paid for the ATS resume analysis. Sending my payment screenshot.")}`;

const tools = [
  { title: "Free Resume Builder", text: "Build a clean, ATS-friendly resume and save it as a PDF.", href: "/tools/free-resume-builder.html" },
  { title: "Job Description Matcher", text: "Compare your resume with a job post and see missing keywords.", href: "/tools/ats-keyword-matcher.html" },
  { title: "Free Python Course", text: "Step-by-step lessons with examples and projects.", href: "/python/" },
  { title: "Resume and Interview Guides", text: "Resume, ATS, HR interview and LinkedIn guides.", href: "/career/" },
];
const soon = ["Coding Practice and Quizzes", "Career Roadmaps", "Aptitude Tests", "Portfolio Builder"];

// Delete any line your tool does not really provide:
const included = [
  "ATS compatibility and formatting review",
  "Relevant keyword analysis",
  "Missing information and section checks",
  "Suggestions to improve your resume content",
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{brand} - Free Student Career Tools and ATS Resume Analysis</title>
    <meta name="description" content="Free resume builder, courses and career guides for students, plus an affordable ATS resume analysis." />
    <style>
      body { font-family: Arial, sans-serif; margin: 0; color: #1f2937; line-height: 1.6; }
      .wrap { max-width: 900px; margin: 0 auto; padding: 0 20px; }
      .hero { background: #eff6ff; padding: 50px 0 40px; }
      h1 { font-size: 34px; margin: 0 0 10px; }
      h2 { margin-top: 40px; }
      .btn { display: inline-block; background: #2563eb; color: #fff; padding: 12px 20px; border-radius: 8px; text-decoration: none; font-weight: bold; margin: 4px 6px 4px 0; }
      .btn:hover { background: #1d4ed8; }
      .btn.alt { background: #059669; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; }
      .card { border: 1px solid #e5e7eb; border-radius: 10px; padding: 16px; text-decoration: none; color: inherit; display: block; }
      .card:hover { border-color: #2563eb; }
      .card b { display: block; margin-bottom: 4px; color: #2563eb; }
      .card.soon { background: #f9fafb; color: #6b7280; }
      .box { background: #f3f4f6; border-radius: 10px; padding: 22px; margin: 30px 0; }
      .upi { background: #fff; border: 1px dashed #9ca3af; padding: 6px 10px; border-radius: 6px; font-family: monospace; }
      .price { font-size: 30px; font-weight: bold; }
      footer { border-top: 1px solid #e5e7eb; margin-top: 40px; padding: 20px 0; font-size: 14px; color: #6b7280; }
      a { color: #2563eb; }
    </style>
  </head>
  <body>
    <div class="hero"><div class="wrap">
      <h1>Your career starts with the right preparation.</h1>
      <p>Build your resume, learn new skills and get ready for interviews, with free tools made for students.</p>
      <a class="btn alt" href="#resume-analysis">Check my resume ({price})</a>
      <a class="btn" href="/tools/free-resume-builder.html">Build a free resume</a>
    </div></div>

    <div class="wrap">
      <h2>Free tools and learning</h2>
      <div class="grid">
        {tools.map((t) => (<a class="card" href={t.href}><b>{t.title}</b>{t.text}</a>))}
      </div>

      <h2>Coming soon</h2>
      <div class="grid">
        {soon.map((s) => (<div class="card soon">{s}</div>))}
      </div>

      <div class="box" id="resume-analysis">
        <h2 style="margin-top:0">ATS Resume Analysis</h2>
        <p class="price">{price} <small style="font-size:14px;font-weight:normal">student price</small></p>
        <p>Included:</p>
        <ul>{included.map((i) => (<li>{i}</li>))}</ul>
        <p>We do not promise selection or job placement. The analysis helps you fix common problems before you apply.</p>
        <p><a href="/sample-report/">See a sample report</a> | <a href="/privacy/">How we handle your resume</a></p>

        {payLink && (<p><a class="btn alt" href={payLink}>Pay {price} securely</a></p>)}

        <p><b>{payLink ? "Or pay by UPI:" : "How to get it:"}</b></p>
        <ol>
          <li>Pay {price} via UPI to <span class="upi">{upi}</span></li>
          <li>Send your payment screenshot on WhatsApp.</li>
          <li>You get your access link within a few hours.</li>
        </ol>
        <p><a class="btn" href={waLink}>Send payment screenshot on WhatsApp</a></p>
      </div>

      <footer>&copy; {brand} | <a href="/privacy/">Privacy</a> | <a href="/career/">Guides</a></footer>
    </div>
  </body>
</html>